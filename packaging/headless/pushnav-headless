# pushnav-headless launcher (installed as /usr/bin/pushnav-headless).
# Runs the engine with the bundled Python and no window; the UI is the
# web interface on port 8765. evf.paths reads PUSHNAV_ROOT to find
# camera_server, data/ and marketing/.

ROOT=/usr/lib/pushnav-headless
export PUSHNAV_ROOT="$ROOT"
export PYTHONNOUSERSITE=1
exec "$ROOT/python/bin/python3" -m evf.main --no-window "$@"
